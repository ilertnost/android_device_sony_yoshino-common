cc_library_shared {
    name: "libsensorfix",
    proprietary: true,
    compile_multilib: "32",

    srcs: [
        "sensor_fix.cpp",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],

    shared_libs: [
        "android.frameworks.sensorservice@1.0",
        "android.hardware.sensors@1.0",
        "libhidlbase",

        "libbinder_ndk",
        "libbinder",
        "libutils",
        "liblog",
    ],
}
