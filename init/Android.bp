prebuilt_etc {
    name: "init.qcom.rc",
    src: "init.qcom.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "init.qcom.recovery.rc",
    src: "init.qcom.recovery.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.qcom.usb.rc",
    src: "init.qcom.usb.rc",
    sub_dir: "init/hw",
    soc_specific: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "ueventd.qcom.rc",
    soc_specific: true,
}

sh_binary {
    name: "init.qcom.sh",
    src: "init.qcom.sh",
    soc_specific: true,
}

sh_binary {
    name: "init.qcom.msim.sh",
    src: "init.qcom.msim.sh",
    soc_specific: true,
}
